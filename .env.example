# Relic V2 — environment
#
# Copy to `.env.local` and fill in. Names only here, never values.

# The world's database.
#
# In development this is the local Supabase stack, which you start with:
#   npx supabase start
#
# Relic's stack runs on the 544xx port block rather than the Supabase CLI
# default 543xx, so it can sit beside another local stack without colliding.
# See supabase/config.toml. Unset in development, this exact value is assumed;
# in production it is required and startup fails loudly without it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# The Librarian.
#
# Optional. Without it the rest of Relic works normally and the Librarian's
# carriage says it is not configured rather than failing — the world is the
# product, and it must not need a model to be usable.
ANTHROPIC_API_KEY=

# Which model runs the Librarian. Defaults to claude-opus-5.
#
# The Librarian's identity, truth laws, and authority belong to Relic and live
# in `lib/librarian/`, not in the model — which is what makes this a knob rather
# than a decision.
LIBRARIAN_MODEL=
