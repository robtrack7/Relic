# Relic V2 — environment
#
# Copy to `apps/web/.env.local` and fill in. Names only here, never values.
#
# The destination is `apps/web/`, beside next.config.ts — not this directory.
# Next reads env from the directory it runs in, and `pnpm dev` runs it from the
# app. A `.env.local` sitting here is loaded by nothing and reports as the
# Librarian being unconfigured with no hint as to why.

# The world's database.
#
# In development this is the local Supabase stack, which you start with:
#   npx supabase start
#
# Relic's stack runs on the 544xx port block rather than the Supabase CLI
# default 543xx, so it can sit beside another local stack without colliding.
# See supabase/config.toml. Unset in development, this exact value is assumed;
# in production it is required and startup fails loudly without it.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54422/postgres

# The Librarian.
#
# Both are optional, and either one wakes it. Without any key the rest of Relic
# works normally and the carriage says it is not configured rather than failing —
# the world is the product, and it must not need a model to be usable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Which of the two adapters runs the Librarian: `openai` or `anthropic`.
#
# Unset, Relic infers it from whichever key is present, preferring OpenAI. Set it
# when both keys exist and you mean a particular one. Selecting a provider
# without its key fails as itself rather than quietly answering through the other.
LIBRARIAN_PROVIDER=

# Which model runs the Librarian. Defaults per provider: gpt-5.6-terra for
# OpenAI, claude-opus-5 for Anthropic.
#
# The Librarian's identity, truth laws, and authority belong to Relic and live
# in `lib/librarian/`, not in the model — which is what makes this a knob rather
# than a decision.
LIBRARIAN_MODEL=

# What a million tokens costs, so the carriage can estimate spend.
#
# Four numbers in US dollars per million tokens, in this order:
#
#   input / cache write / cache read / output
#
# Relic always records tokens — those are measured and exact. This only prices
# them, and only for the model above. Leave it unset and Relic uses a published
# rate if it knows one for that model, or shows tokens with no money beside
# them if it does not. It never guesses a price.
#
# Four rather than two because a Librarian conversation is mostly cached
# tokens: pricing a cache read as fresh input would overstate the bill several
# times over. Anthropic's published rates for claude-opus-5, as an example of
# the shape:
#
#   LIBRARIAN_RATES=5/6.25/0.5/25
#
# There is no published rate in Relic for the gpt-5.6-* aliases, so set this if
# you are running one and want a cost estimate.
LIBRARIAN_RATES=
