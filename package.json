{
  "name": "relic",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "verify": "node scripts/verify-repo.mjs",
    "test:scripts": "node --test scripts/*.test.mjs",
    "backend:baseline": "node scripts/verify-backend-baseline.mjs",
    "backend:baseline:reset": "node scripts/verify-backend-baseline.mjs --reset",
    "dev:web": "pnpm --filter @relic/web dev",
    "build:web": "pnpm --filter @relic/web build",
    "lint:web": "pnpm --filter @relic/web lint",
    "test:web": "pnpm --filter @relic/web test",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop --no-backup",
    "supabase:functions:serve": "node scripts/serve-functions-local.mjs",
    "test:supabase": "supabase test db",
    "eval:retrieval:e1": "node scripts/evaluate-retrieval-e1.mjs",
    "e2:preflight": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/e2-secure-bootstrap.ps1",
    "e2:audio-fixture": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-e2-audio-fixture.ps1",
    "phase-g:fixtures": "python scripts/generate-phase-g-fixtures.py",
    "phase-g:pdf-smoke:local": "node scripts/smoke-phase-g-pdf-local.mjs",
    "phase-g:pdf-smoke:hosted": "node scripts/smoke-phase-g-pdf-local.mjs --hosted",
    "phase-g:image-smoke:local": "node scripts/smoke-phase-g-image-local.mjs",
    "phase-g:image-smoke:hosted": "node scripts/smoke-phase-g-image-local.mjs --hosted",
    "e2:smoke:hosted": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-e2-hosted-smoke.ps1",
    "e3:smoke:hosted": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-e3-hosted-smoke.ps1",
    "phase-e:smoke:hosted": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/invoke-phase-e-hosted-smoke.ps1",
    "e3:demo:staging": "node scripts/manage-e3-staging-demo.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
